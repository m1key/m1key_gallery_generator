<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title %> &mdash; Photography and Art Portfolio by Michal Huniewicz</title>
  <meta name="description" content="<%= blurb.gsub('"', '\\"') %>" />
  <meta name="author" content="Michal Huniewicz" />
  <meta name="robots" content="index, follow" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <link rel="canonical" href="https://www.m1key.me/<%= genre %>/<%= slug %>/" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
  <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
  
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&amp;display=swap"
    rel="preload" as="style" />
  <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;500;600;700&amp;display=swap"
    rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@800;900&amp;display=swap" rel="stylesheet" />
  
  <link rel="stylesheet" href="../../styles/base_responsive.css" />

  <!-- Main favicon for modern browsers -->
  <link rel="icon" href="../../favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="../../favicon.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
  <!-- PNG fallback for maximum compatibility -->
  <link rel="icon" href="../../favicon-48-dark.png" sizes="48x48" type="image/png" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="../../favicon-48.png" sizes="48x48" type="image/png" media="(prefers-color-scheme: light)" />

  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />

  <meta property="og:locale" content="en_GB" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= title.gsub('"', '\\"') %> by Michal Huniewicz" />
  <meta property="og:description" content="<%= blurb.gsub('"', '\\"') %>" />
  <meta property="og:url" content="https://www.m1key.me/<%= genre %>/<%= slug %>/" />
  <meta property="og:image" content="https://www.m1key.me/<%= genre %>/<%= slug %>/<%= slug %>_01.jpg" />
  <meta property="og:image:alt" content="<%= title.gsub('"', '\\"') %> by Michal Huniewicz" />
  <meta property="og:site_name" content="M1key.me" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title.gsub('"', '\\"') %> by Michal Huniewicz" />
  <meta name="twitter:description" content="<%= blurb.gsub('"', '\\"') %>" />
  <meta name="twitter:image" content="https://www.m1key.me/<%= genre %>/<%= slug %>/<%= slug %>_01.jpg" />

  <!-- Image gallery structured data for SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ImageGallery",
    "name": "<%= HTMLEntities.new.decode(title).gsub('"', '\\"') %> by Michal Huniewicz",
    "url": "https://www.m1key.me/<%= genre %>/<%= slug %>/",
    "datePublished": "<%= upload_date %>",
    "dateModified": "<%= update_date %>",
    "author": {
      "@type": "Person",
      "name": "Michal Huniewicz",
      "url": "https://www.m1key.me/"
    },
    "publisher": {
      "@type": "Person",
      "name": "Michal Huniewicz"
    },
    "image": [<% photos.each_with_index do |photo, index| %>
      {
        "@type": "ImageObject",
        "contentUrl" : "https://www.m1key.me/<%= genre %>/<%= slug %>/<%= slug %>_<%= photo.id %>.jpg",
        "caption": "<%= HTMLEntities.new.decode(photo.title).gsub('"', '\\"') %>",
        "width": <%= photo.metadata.width %>,
        "height": <%= photo.metadata.height %>
      }<% if (index + 1) == photos.size %><% else %>,<% end -%>
  <% end %>
    ],
    "description": "<%= HTMLEntities.new.decode(blurb).gsub('"', '\\"') %>",
    "keywords": "photography, art, portfolio, Michal Huniewicz, m1key.me, <%= HTMLEntities.new.decode(title).gsub('"', '\\"') %>"
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.m1key.me/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "<%= genre.capitalize %>",
        "item": "https://www.m1key.me/<%= genre %>/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "<%= HTMLEntities.new.decode(title).gsub('"', '\\"') %>",
        "item": "https://www.m1key.me/<%= genre %>/<%= slug %>/"
      }
    ]
  }
  </script>
</head>

<body>

  <main class="bigger-container">
    <nav class="navigation" aria-label="Gallery navigation">
      <ul>
        <li><a href="../" class="nav-link">&lt; Back to <%= genre.capitalize %></a></li>
        <li><a href="../../" class="nav-link">&lt;&lt; Back to M1key.me</a></li>
      </ul>
    </nav>

    <header class="site-header">
      <h1 class="page-title"><%= title %> by Michal Huniewicz</h1>
    </header>

    <section class="information" aria-labelledby="info-heading">
      <h2 id="info-heading" class="visually-hidden">About this shoot</h2>
<%= description -%>
<% if small_print.to_s != '' %>
      <p class="smallprint"><%= small_print -%></p><% end %>
      <p class="smallprint">Uploaded on: <%= upload_date %>. Updated on: <%= update_date %>.</p>
    </section>
<% if map_url.to_s != '' %>
    <figure class="map">
      <a href="<%= map_url %>"
        target="_blank" rel="noopener noreferrer">
        <img src="<%= slug %>_map.png" alt="Map showing <%= map_title %> location (opens in OpenStreetMap)"
          title="<%= map_title %>" width="320" height="240" />
      </a>
      <figcaption class="visually-hidden">Map showing <%= map_title %> location (opens in OpenStreetMap)</figcaption>
    </figure><% end %>
  <% photos.each_with_index do |photo, index| %>
    <article class="photo" id="<%= photo.id %>">
      <header>
        <h2 class="title"><a href="#<%= photo.id %>" title="Link to this photo"><%= photo.title %></a></h2>
      </header>
      <figure class="image-container">
        <img src="<%= slug %>_<%= photo.id %>.jpg" alt="<%= photo.title %>" <% if index == 0 %>loading="eager" fetchpriority="high"<% else %>loading="lazy"<% end %>
          width="<%= photo.metadata.width %>" height="<%= photo.metadata.height %>" />
        <figcaption>
          <span class="description"><%= photo.description %></span>
          <% if photo.metadata.iso.to_s != '' %><span class="technical">ISO <%= photo.metadata.iso %>, <%= photo.metadata.focal_length %>mm, f/<%= photo.metadata.f_number %>, <%= photo.metadata.exposure_time %>s.<% if photo.technical_info.to_s != '' %> <%= photo.technical_info %><% end %></span><% end %>
        </figcaption>
      </figure>
    </article>
  <% end -%>
  <% if sources %>
    <details class="sources" id="sources">
      <summary>Sources</summary>
      <ul class="smallprint"><% sources.each_with_index do |source, index| %>
        <li><%= index + 1 %>: <a href="<%= HTMLEntities.new.encode(source) %>" target="_blank" rel="noopener noreferrer" class="nav-link"><% if source.length > 100 %><%= HTMLEntities.new.encode(source[0..50]) %>[...]<%= HTMLEntities.new.encode(source[-30..-1]) %><% else %><%= HTMLEntities.new.encode(source) %><% end -%></a></li><% end %>
      </ul>
    </details>
  <% end -%>
  
    <nav class="navigation" aria-label="Gallery navigation bottom">
      <ul>
        <li><a href="../" class="nav-link">&lt; Back to <%= genre.capitalize %></a></li>
        <li><a href="../../" class="nav-link">&lt;&lt; Back to M1key.me</a></li>
      </ul>
    </nav>

  </main>

  <footer class="site-footer">
    <nav class="footer-nav" aria-label="Site navigation">
      <h2 class="visually-hidden">Footer navigation</h2>
      <ul>
        <li><a href="https://www.m1key.me" class="nav-link">M1key.me</a></li>
        <li><a href="https://www.m1key.me/photography/" class="nav-link">Photography</a></li>
        <li><a href="https://www.m1key.me/about_me/" class="nav-link">About me</a></li>
        <li><a href="https://www.flickr.com/photos/m1key-me/" target="_blank" rel="noopener noreferrer" class="nav-link">Flickr</a></li>
      </ul>
    </nav>

    <div class="legal">
      <p>&copy;2010&ndash;<%= year %> Michal Huniewicz &mdash; m1key.me</p>
    </div>
  </footer>

</body>

</html>